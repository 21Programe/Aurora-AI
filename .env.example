# Aurora IA — configuração local
# Copie este arquivo para .env e ajuste somente o que precisar.

# Diretório de dados/runtime
AURORA_HOME=./aurora_core

# Modelo GGUF
LLM_MODEL_NAME=Meta-Llama-3-8B-Instruct-Q4_K_M.gguf
LLM_GPU_LAYERS=25
LLM_CONTEXT=8192
LLM_BATCH_SIZE=512
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=1024

# RAG
RAG_ENCODER_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=3
RAG_CHUNK_SIZE=1000

# Monitoramento
RAM_THRESHOLD=85
CPU_THRESHOLD=90
GPU_TEMP_THRESHOLD=82
MONITOR_INTERVAL=15

# Logging
LOG_LEVEL=INFO

# Integração externa opcional
# Nunca coloque uma chave real neste arquivo versionado.
GEMINI_API_KEY=

RAG_MAX_FILE_BYTES=20971520
RAG_MAX_PAGES=200
MEMORY_RETENTION_DAYS=90
MEMORY_MAX_TEXT_CHARS=12000
